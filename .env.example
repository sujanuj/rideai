# Copy to .env (never commit it). Both the backend (mvn spring-boot:run) and
# docker compose read this file.

# AI Trip Assistant: https://console.anthropic.com → API keys. Empty = rule-based summaries.
ANTHROPIC_API_KEY=

# Error monitoring: https://sentry.io (free). Empty = off.
SENTRY_DSN=
# Browser errors, used by docker compose. For `npm run dev`, put this line in frontend/.env.local instead.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed outside local dev: openssl rand -base64 32
# JWT_SECRET=
